&lt;p&gt;&lt;img src="https://cdn4.telesco.pe/file/odlbdawshpge6uSQ_1zLaCBtAuKK5qIWY56CSzmZT6YHzUxINZN9IAsE5icjiGfRv_6gSKwIneF4ZEyDh7kOHT8gPg_NDvo1R1bCH_gcIoXq9OxMuwAh1ibJ8oDffgkecOF3bhZmoLTN1nt4NHeGchwhTNtovSK7ajPYS3eLIg3gDVfyrHhZT1KPkgIm_mlHKLnSHBK1lGsNichjGtJ7PXzd0hLqv4Lbq_VG7DfwqzznhLz3OO2A5l0EAZbbUfylG4Xd3BU7-3bmVPfgeuqjmjoLhcqRWvgeIOOraAHNkGK_gQZ6nRLW7HHcnA114ItjmkHS1rbnQEANbGIFHkDvGw.jpg" alt="Telegram post image" style="max-width:100%;height:auto;" /&gt;&lt;/p&gt;</content:encoded>
