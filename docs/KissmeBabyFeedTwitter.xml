&lt;p&gt;&lt;img src="https://cdn4.telesco.pe/file/q6ueIoN8vWB6LF6Gn8ZM8XagrVtgRFm24gQoubWajbF4oNya5gWJaDFtCCjqcTkMnRv1-5dweRICzyKr4Rqaqy1x9FffVyKe4fL3SLeZpMFqe0YOxBwxdpHi8vordVR-ClDGe5Plz28NO7a0aHUfL8x--IGrQfnBIja-xIpFtbEyCD2IhvBW5xBKyZK20uK4NJVqa05wEVJCCH2SxJPl6CbvZnFkYTjkaHGsaAmpZr9Q7AMIq8h9p81oSW5BLxiZWF1uYQkVHS7Z2_QKsPA8_wa1TZ06YjYzRIuRdwvlZoTWKu7V9FE2BqXZg06lAeLxOK3ZPXTkFQx1q1R6Nv7KSA.jpg" alt="Telegram post image" style="max-width:100%;height:auto;" /&gt;&lt;/p&gt;</content:encoded>
