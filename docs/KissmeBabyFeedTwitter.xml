&lt;p&gt;&lt;img src="https://cdn4.telesco.pe/file/L9anqxjCfo248xO7f_s7cXN5vy8yGcgX3ebyF02clHvmYdXQKIWdTyNiApAXDC-abq1hEgavqRnsPHVwO2hg3LitgHQzAd0CABIFh_CgktnTwg67fxAM35DynpgMS4CM4FnMegu3XyDlaHbayaWPWX75RPzSWPRMQKuNlk5ewmt3BrdgEx0A7aYIDT6qo7rXp6kt9VIE0yl0HFUWUxO06fHp0dnIWkNqhNZlVm7f34cIy6D_j8acvsGvN4tFVGvMeA0gvRH9Izgk0ct3dZtOUrrQc1v9y0l971_c0QQy_pojJl0YE4Lz9QRX6j--rxC06ONsePKADJvYxJ1J3GY_jg.jpg" alt="Telegram post image" style="max-width:100%;height:auto;" /&gt;&lt;/p&gt;</content:encoded>
