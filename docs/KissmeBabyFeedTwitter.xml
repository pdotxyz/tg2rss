&lt;p&gt;&lt;img src="https://cdn4.telesco.pe/file/eXm6h-UeRZSRCtA-zEoZFrmXpY_aWxQjGG2DU01Dw53mU-TR7ejVzPb29qrwBT3y4NVFzFHI68gQa4VzCDKw7nJ84JNcyg_r-_oDaIPfUXOkSeDmqfiHiOTgrH6-qOMJBimG6ZW7pNRd8wsrcYhchSDXt1ACxyxnQwk4xHiHXVHI1s78U884Cuy5qISfagwWrXF-_InZPSyGAEoaSO2z79oHoek32k7rXjJ8gBY7_UVMG5O0Fl4fm0zLfuV65h1y_CHyxCrX8qJn9dLWQgGfkmAUJFNBMwF_PvJQaWaBTbyti-SBOeyU2qxF4nza5Aft0rSIy5VURbbd9QEXOCTatQ.jpg" alt="Telegram post image" style="max-width:100%;height:auto;" /&gt;&lt;/p&gt;</content:encoded>
