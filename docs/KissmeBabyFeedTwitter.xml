&lt;p&gt;&lt;img src="https://cdn4.telesco.pe/file/cFk-gon3AIUwOBXKV1OUJ7Bnl-Tjm1GPaEm0L9yeNbYk1ut2g1SHAeavCInTQGw6r-TZGgDUG-5xFzoGTQM-PryWxiR31qK0RTTBoPzJSy8TfezVbVlrV3Yf1onoEQOA6r3z1TDcC-I2E-jrm8Wv9_qFyFU_dOxyLEvczgWTGEUoSmI1fm_Q1lLIju9v5qP80emAlECsGEZ0J-WPGm_tu3i6P2bDVS8Mw9XwsSTh8WomDP_IkHsQ8f0t5geKbyH7WlFzAxL3n4IokDSWD67IEx05r_7E2SIgdy7Zp3Z2lCH38z_v1sEIC7dVQur7Sh4ZniOSuOFg-CX8t57tXcy6Cw.jpg" alt="Telegram post image" style="max-width:100%;height:auto;" /&gt;&lt;/p&gt;</content:encoded>
