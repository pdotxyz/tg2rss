&lt;p&gt;&lt;img src="https://cdn5.telesco.pe/file/beq-Z7Fwu845QcdLoldBx8i_AvlEc7oD7WBrRLeKa4F6AaPXIpxKQ-tqSqaMPmvjAJsPES6-uAuO8oQ1GAMOhAoF1t055UYSBrSLQbCfFp4TH01PZfe1MtnL19duSvV6ScoMYcIAB9yTSlqy4fyH5x51D5tmEFSKsywujWLY9lRIhENolERoS32M4cFZOg_EdHPsyjDc2pnqw7fBrMYdcvPl5u7l0ZTrcdzt97nIijC1DCVG8QDzaC3dWmzzYY1m0fbYy6l8iT_x9D_0WgiGvJav97GweTHLa3g7IKQtyQnomQVBo3CenRNU3Zx_K2HWygIOJhXGQQJY1edXo2I-kg.jpg" alt="Telegram post image" style="max-width:100%;height:auto;" /&gt;&lt;/p&gt;</content:encoded>
