&lt;p&gt;&lt;img src="https://cdn5.telesco.pe/file/XxwFGEfo5hilVGJdaE_3dzqCOWY_iSoUkroEXwcDPlGt8N2sTg8_SPA0zlZ3Wo5g49NDmvqFb-RqQ5Sst8iIji77YgcKv7dneRgAPlWgmycB0LpaY1F6JtsskBh7iBXGCDgE-R85bOWpdoZiz8UMOFdfijFSfQBdNPbvv4KIAN6nggJdw76ubNYXIIdD-2fdtDfRKDphhPedYch9kfH5N1g5qpbyllRcQIBQw5o-xIcV8Gk1yW4K8AYPfQgZk8QtMCx6jkyxkM_XodRlZhcRnGM8qcZBMHP0zu-epeevReA5DJiNLaPQZd7FWLdQ5S4fsbkb-xSzlp5djgplA3_sUw.jpg" alt="Telegram post image" style="max-width:100%;height:auto;" /&gt;&lt;/p&gt;</content:encoded>
