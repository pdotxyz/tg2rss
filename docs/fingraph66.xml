&lt;p&gt;&lt;img src="https://cdn5.telesco.pe/file/vLGn5-y4xrSPZqt26ElHobpkbhjDgHFz36EvHkPZMVjBcvLDR11fdl7JcMC3Fqod9uWehr_8MONVy0nXrKc0CI1idTAUdK8ElGySsGya9GQCMYAUCyU8xZi_SQSmIu9J8EkGquypJAVbX2fs10ZKE9gIfdXlgWdOtiNzc_5LKa-lbQVBh7bAIEm2B7ZlZZOMJ3syTDdh9MJwq6pNRO-hLxhKmRNcWaIsSFc2jcKzAP_8YXEh2QAum-CeV1jsDiHZsQIk2ynzY6YJpf3f9nMMcoRE_XpeFbnsw3DVjxa3kuCPpiBtCGAItW-uOIlb-uWo89vEYJHFnrH_USHeXEyXiw.jpg" alt="Telegram post image" style="max-width:100%;height:auto;" /&gt;&lt;/p&gt;</content:encoded>
