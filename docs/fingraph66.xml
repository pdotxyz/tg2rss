&lt;p&gt;&lt;img src="https://cdn5.telesco.pe/file/mJbSe12KQRkXwqsj71leDurS2lPP0B28wBF9pkSD7PV_VSJafQBchs8D7QYWc-hi91GTz6ZDA_h8CjBdePW1oENbdlQmNNaMMoaeyCWE1wJoIii85K762iFP0qnivM5MJMzZ04prY-t0uN4fs2YHcQunOqjR275mAiv5zQZ4YUHMqC2dkvwRDb4C8qMA75BnZT0nkCDigXeRFFZZMgShH2n8vp3GOeiRR_bCrDhTJjw4AUOHkJEAnLUYVlRphmbnDqsFv7BAKkhkYXvNntEtygsZA8_KFPONkPdlcf3UvqPYj_1_6VMbtBWzFk5e-EycpG805DCY9ybR4Tb2AOxCsg.jpg" alt="Telegram post image" style="max-width:100%;height:auto;" /&gt;&lt;/p&gt;</content:encoded>
