&lt;p&gt;&lt;img src="https://cdn5.telesco.pe/file/Tf0rgAesCuGB_D8bF0yFDej2pss64zAoNl1Q4SNSdE4_bY0h170CVszEtqf_CTWzk4Ef5m13ushD0oS8bePd72mvIVyCUQ8T0InUYTrJrOWBIdYRHaZFbxQhgoNygqIk2lCTVkPbR5cTf-I8SK7qarTnDERCLr4XB9KncVx36Ya1LWhh_JI6Nj4E5i7ksaPTwuh8PVcpUVSh5loOv8g7DAskigvNj7yhj1sTXJuGmZuAo98FZgrbYJHepjpNpIw9CcpTdNivpsx_5xMVb_VbQ3eCdlxi1dG9ShuP6cfIp9xdNuoWYA_6XmRpQNhdHB-c_PONzoVGLJNoKQdXL9QunQ.jpg" alt="Telegram post image" style="max-width:100%;height:auto;" /&gt;&lt;/p&gt;</content:encoded>
