&lt;p&gt;&lt;img src="https://cdn5.telesco.pe/file/a6XzUq3HnCfVZh3bCpLXFWxKygRkC68Qu0yHnrR06QxsVwQVZw-eujcz0FlgwimTMfp-HHQA-eb9WetJ1BSa9HUnHtF0U5XKGdWSAKmCoxqb82IOjnOKvbkJpGygmjv6pWz4vxQyi3nrIlOcKmPpc5awuUUd-4z3JuWSlPLifC4zTQq2__kgT_GQ2SgCU3mT7uEOdgD1FPtqqSLeTS5cFMKAbS_IgPUD2_xdDtqP53htuhdK9BYxyBMKJPeDV4knkg1nypASt_1L9KvHYKUqWjsmgLjf_oY-wQVA_ZUiyMUR6MT34TMoFokZLVRbhJ0C4GYFeSQgZJAp3VPFNy1PSA.jpg" alt="Telegram post image" style="max-width:100%;height:auto;" /&gt;&lt;/p&gt;</content:encoded>
