&lt;p&gt;&lt;img src="https://cdn5.telesco.pe/file/T5XkAGlhDKUKLMcROPZff3xiKdMlnx4GTa5_Fu7hxy8ZQjWdFhPxQlooQvsKAEDrxolsf2NyLvz2CNwdYVv6j6J5MDWCrcnYu-MC0qlMIvCyT6-BV1iv8juCfVt-RyDT2gmZKQGPQkkEy9Ki85u05Tt59mk7M2qkopIDasc9hiB5u3ElknFxEB_Gqwg1MVKdPBLKt0P6K7f7cOiSNS5an5vGxmnuMjLFOyVh5ccHOt046x96JRh47BGfSfHXNstYGiI-0R0DF9YIi9kSc66CyT9jaD90z_509qvjM_7rpvVNshmfDftqz-7Q1pgdelKqrwOOI8se7lvZdIcCKNEwCw.jpg" alt="Telegram post image" style="max-width:100%;height:auto;" /&gt;&lt;/p&gt;</content:encoded>
