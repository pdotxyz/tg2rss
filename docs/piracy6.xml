&lt;p&gt;&lt;img src="https://cdn5.telesco.pe/file/onE5ida_4ROinM4d2zOtmrLpEsrNeBabK3ZKgYgpZxS-e0_dVWMiGF4rPKNyrCDzAR1zUv-D1VRtU8kaaCwmzZI6rlIVQHoEZJHcqcNDH_m0qINpkdnXw3Tp_rEzxsnHdqbrqT9cSWisUnpZiDMpIhVxBPf1u_TnEidHtuadrenuZhuaOqlRZGavc4ENNTHceewX3zv8X8wmgwDS5o_hhb3BQrFtBcFC0S_g7vx9wvCSltPH2-19UWwxfRnS1TTrFsQxwykGCZ5vRHdUf04k3MzQiu6Ql7Uho5Lup0azbwyVbGIIYfNXkvfYC_TdBR8ryP73X5NltSAQZnEVq20bOw.jpg" alt="Telegram post image" style="max-width:100%;height:auto;" /&gt;&lt;/p&gt;</content:encoded>
