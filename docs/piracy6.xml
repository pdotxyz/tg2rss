&lt;p&gt;&lt;img src="https://cdn5.telesco.pe/file/BGVJBrJANqLMwc7Lpfd0ECBWUYnvt-xFESrFXKxnuSRsceUZnsgYux-qTy3KgKKUmLswxaDoNNIDc5sOYYUKE4IvT7_wDW_cfI7KqBJ6cAPTlVxOQryYgWrqq7qONgzOu_ldtwTkmZhtGeIyDZRKKvMePV3cpqvdmcH9fLTGwypGOu6pwPGLD6bBkvYJrDwYTOiTNb_OP5nuEqXJaEkQ3Mch8pU01o-NGM5dWqr-yffAuQC9Bmwp3f7ZqvZ_Jzs-1Ipm0jabsgcLHojmN_PPAbBEOVfZo8dosgdSTaDvvlN0UJKh8JuvWtAHgiIUEfXQPQQJ0kS3Q__jd2DxRQ0IyQ.jpg" alt="Telegram post image" style="max-width:100%;height:auto;" /&gt;&lt;/p&gt;</content:encoded>
