&lt;p&gt;&lt;img src="https://cdn5.telesco.pe/file/Nl9JWbmHM3H98CiNbSC_6z6TemWOQtksIv7oN-1b0O0dhA487rL0C6C2Ib5BPH3an5aFFZGuOEN6GccEsmbVhkKa_Ge4ZK0UJsNIWUmRD9UMnwQ7s2gdvYvx2JeovDEPKwIUqB6R6Lml-902p4PeKCEDUtlPRe8hw1dZcoAo-yFU5Mu-7hXorDG3JCL_qJWBjdTDZHEfLL9uVJi9ocJh7E2KO6Wtud-RhXcz7uvN6EX5hEunF3eOi1oGdCRBKVDtDcsmylLa6uSaNaO5KlMAIwqxCwQkMKKA7I8eV7sCBECJ-bSn1x7Zm_7V7OcOvh7N8prhtFEgDTUsYqhW3Wf-DA.jpg" alt="Telegram post image" style="max-width:100%;height:auto;" /&gt;&lt;/p&gt;</content:encoded>
