&lt;p&gt;&lt;img src="https://cdn4.telesco.pe/file/KobjBZdvbz_jHScSq0AJ_GE60QK9ypGKqqebhbh-CtVsj_cwzyUD8jnwOT_ANUottYSVTVVa-hi7RgzBhKFpxrA9nWyDcgY2cHIrc0u_3Bte9StiCvNxDrDqmSf-bNmr4MWCyWGtpwTzPSUkrB7ikgPBXwR8ysLqrcJb_4HTJzWEw1GBA8bjBEmLiQlYA2vbZ6wHACxCd-qrHOVUTrlVsYcFTMlWFSO35hj5Zdd8qLFuxIInpbskHuzPIwQZ6ePCGknolbuOC8ObUrCMRki4GOvKNJUJWl75EawZAz2ZS_bMK7DLPs0Pe4FTszndDZoHA-PvUDM54qtjATioqe7M_g.jpg" alt="Telegram post image" style="max-width:100%;height:auto;" /&gt;&lt;/p&gt;</content:encoded>
