&lt;p&gt;&lt;img src="https://cdn4.telesco.pe/file/T2Fejr1XnFHLIbKQES_g1eU1EnKbO8Tew6wV5BYArVaRuJz-X1CH0BK1bVLrIdWa0NGm0dCNxvpf198tUkDMtWfspiN9fU9i4gTdme4fF1z_DiBNkUUqu_yyaezobmyv-4H2xRaZfgTTkasH_Z73NQV77825dyZL2nntJH2lg5eTOh5nq22UPY8wjsSNBzRzf7Cpsccx9CJs_0avOqV-yJLHY7WdrXCsosf1izh_6yOn1SBT7pqWHdsvIViiEx7_-uaNuhJmxTsMuq8aVkPVoV1HoWhLyfpwYySwsxyXEvidhAwgOPX54-t9T0LLMnhqW3tvz7lbYfyVFL0qE6iEvQ.jpg" alt="Telegram post image" style="max-width:100%;height:auto;" /&gt;&lt;/p&gt;</content:encoded>
