&lt;p&gt;&lt;img src="https://cdn4.telesco.pe/file/ni5qaI61NuYlwEjCfL0W3zP-_JicRXx11adkv4yXBJILQxPd6zXgDkaHBsHayS8c23UCVmBURwpqcR2TEXqUu42mL5zaZES2ovmjRfnmofbaPuPj2ZhaJ2uFpPBd45RINwE7LcpL1HK8DgsCnIqnbTOOVne9KZfEmedb4JRaVqgBtG6NjSveDVpTYHv8fgdhxlvGzUvWcxAGGlFwOrbrSKSA5Wuti_VebUiHlGRG8aJV3qQ0Dvd9iJzMBrS-sRW_RupXFHKsnvkkVULK4YDrU40CrojhtrCHlsUcGbHbyK0noQAK_yE5e1POmPhuQWT78zc-6znaBuRhWdOSQX9VKg.jpg" alt="Telegram post image" style="max-width:100%;height:auto;" /&gt;&lt;/p&gt;</content:encoded>
