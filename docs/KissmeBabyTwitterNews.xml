&lt;p&gt;&lt;img src="https://cdn4.telesco.pe/file/UY3p4n0As0UtOlXWmraKtmUWzqdcCiRd9kZ9auqKAI5hjcrkDII9QTP5Kt_1mwDiRXz7oSpVFEjKGeYq10tV72WQArGgvoxmYNOFKulCa_quJc-dioMCOnAd1gufGRKg2mSpN8juF8G9D6n089Alm1Q_U3MqdNfwMSV5BsCKQnwxcHSaPYiYjI6uyAVGK0tChztySA2GR8BoHo3CD3s0AaBhZCeiyfD4oKZqwurnhRlBxuCQ_lKXLHr7-u_ZQia0rnPF-xy0gqPxO1oD2rSGN0vJw-DUfV-xx8qwYNtAcG8hT2N7ISKhit4GliKoxSCiFV7h85vHbu0NXmdF9E2j7Q.jpg" alt="Telegram post image" style="max-width:100%;height:auto;" /&gt;&lt;/p&gt;</content:encoded>
