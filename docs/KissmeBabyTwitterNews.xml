&lt;p&gt;&lt;img src="https://cdn4.telesco.pe/file/ORrRXPaz20B92m_RzNGLL9B3V9Dn6tV7T7Hzy16ToFejRAbvhXof_wvIUWeIEXkc0h0W1kkb11AoN2aDffx-AtbZIkyf6teGiW31sGJhrxEPu38dNRqpB6IdwDijTnGsuTbtafuFNUd73M3TEhOJ5H6Ykuy53mEFIsxLKq9nAb5FgN363nU_kBJKDW0vOkPvwRzhrQiXqcGTI0IICi7W1cgsPXCe1b5YmhlQKntCyiHjzfXV9BblKeIsJNtO1AQvcZwbaI2cvUb9NYvq8JIr4rZwZwAwojw9Xj7HMxPi8jSL0ZGXzh77WQz8krrURW9kFs8purXxZ5Oc1p_XEYx4Tg.jpg" alt="Telegram post image" style="max-width:100%;height:auto;" /&gt;&lt;/p&gt;</content:encoded>
