&lt;p&gt;&lt;img src="https://cdn4.telesco.pe/file/ggxL4vz-leDT4gRLNhYjb3wzVp0XS0lD91dP7uOgpDPqtEXPsiHovcrrM2eynvZ59w7vGAYfIPqaYtFHZGmTbXrXUaTnPH3JT_gVI03439grbDtkrKJTydnVKUShgda4ZZMrJCPsz6VibiQOiF6ac0mrkbJ4CaJg-EC-eZeW_o78KIuC2-ZapR8dbbrChZSGgf_lkpnopMuvzctnoeyIKpLchLDL1IUoe4kfOocpYR9MNlBJGtwnBIxPT8ySu4_3uPNPKXM5rzgkfMMIeBbRO-Cx5cDpD5Sq9yJM_OhYtBMGj4JCxxamBBJ0ihQ_BsKEavoF0kIhCs8YYVwLvbwgww.jpg" alt="Telegram post image" style="max-width:100%;height:auto;" /&gt;&lt;/p&gt;</content:encoded>
