&lt;p&gt;&lt;img src="https://cdn4.telesco.pe/file/XbHa1sI5yOScQ4Si0Xnnkg2UM2ibd67yStAGFyOqJlyLBa18xO4m_RHG6tpvdedLwO-_wv4fq17rZ2BABD65dBDw5PtclVEF24O7oJPMEB0q3WkU1-JH5wT4CruFdDZv2qKG_cUcVrQTqwsBCVOGnkCXMjne7yMTC936s6wk0pWNAGtSBJ3E8H-3Cc_bssmQ0eWAjwjy4K_NfbZusxEcWucGzA94fcqy4S-8dSCD1IHzrXUHJUQGSMp76SkfXrmtrJu4IAOfKMWGtHkmBLi-GMgDY9eaXwDAC_7OYB1XeEVic42e8OIICJr3EcUa1IuhT28rRxPArc5TVePcztL-jQ.jpg" alt="Telegram post image" style="max-width:100%;height:auto;" /&gt;&lt;/p&gt;</content:encoded>
