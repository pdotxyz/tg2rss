&lt;p&gt;&lt;img src="https://cdn4.telesco.pe/file/hpH3LHHIJGzhPy_F8Jzt1z9g6lhyf82ktaT0eByE6iEr4EQFJnltMcPdzgVv6IGpKsd2UTEHX4hJRV48CPsyzIR0KUlvMjafjWufuSYsBIBFU9yHW8FiG-lWXWJgTlmXPmLRGhhIjxL3GaVWin9E36f3rHcR77mysD4jaezhl4VUbAUliVNK-zNq-TVmn7HpG_b513FroYorLtZSn617B0aRXH_NIk8t7wgA7Be3inTOIBFXoSI82zBZl_dKHWqu7nh9-2pvxTy1J56pQozx0n1lfDeLu3sJrwXR2v3NnQBRG1ok24fZFlxFSs0Cu6uUc1ACDTyL1lyNJhoq238VvQ.jpg" alt="Telegram post image" style="max-width:100%;height:auto;" /&gt;&lt;/p&gt;</content:encoded>
