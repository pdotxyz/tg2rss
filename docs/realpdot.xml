      <link>https://t.me/realpdot/8774</link>
      <description>&lt;div class="tgme_widget_message_text js-message_text" dir="auto"&gt;&lt;b&gt;Sumit&lt;/b&gt;&lt;br/&gt;CacheGraft: Enhancing Retrieval-Augmented Generation via Latent-Space Document Enrichment&lt;br/&gt;&lt;br/&gt;Fuses a large model's KV cache into a small model's for each passage offline, so RAG at query time needs only the small model.&lt;br/&gt;&lt;br/&gt;&lt;i class="emoji" style="background-image:url('//telegram.org/img/emoji/40/F09F939D.png')"&gt;&lt;b&gt;📝&lt;/b&gt;&lt;/i&gt; &lt;a href="https://t.co/6wPelOKY1K" rel="noopener" target="_blank"&gt;https://t.co/6wPelOKY1K&lt;/a&gt;&lt;br/&gt;&lt;i class="emoji" style="background-image:url('//telegram.org/img/emoji/40/F09F91A8F09F8FBDE2808DF09F92BB.png')"&gt;&lt;b&gt;👨🏽‍💻&lt;/b&gt;&lt;/i&gt; &lt;a href="https://t.co/TWul2KhtyS" rel="noopener" target="_blank"&gt;https://t.co/TWul2KhtyS&lt;/a&gt;&lt;br/&gt;&lt;a href="https://x.com/_reachsumit/status/2118587060722577808" onclick="return confirm('Open this link?\n\n'+this.href);" rel="noopener" target="_blank"&gt;tweet&lt;/a&gt;&lt;/div&gt;</description>
